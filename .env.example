# Sao chép thành .env.local và thay các giá trị mẫu bằng cấu hình của bạn.
PGHOST=localhost
PGPORT=5432
PGDATABASE=shop_app
PGUSER=postgres
PGPASSWORD=your-postgres-password

# Cấu hình ứng dụng Web từ Firebase Console (cùng project với Admin SDK).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Chỉ dùng trên server; private key ở một dòng với ký tự xuống dòng viết thành \n.
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
